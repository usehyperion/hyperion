{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"deep-link:default",
		"fs:allow-exists",
		"fs:allow-lstat",
		"fs:allow-mkdir",
		"fs:allow-read-dir",
		"fs:allow-read-text-file",
		{
			"identifier": "fs:scope",
			"allow": [
				{
					"path": "$APPCONFIG/**"
				}
			]
		},
		"opener:default",
		"os:default",
		{
			"identifier": "opener:allow-open-path",
			"allow": [
				{
					"path": "$APPLOG"
				},
				{
					"path": "$APPCONFIG/**"
				}
			]
		},
		"process:default"
	]
}
